# Runtime data: journal.db (+ -wal/-shm) and secret.key. Back it up; never commit it.
/data/
# Local dev/run data and the dev binary (see Makefile)
/.local/
# Build output
/bin/
# Vite build output is embedded into the Go binary; only the keep-file is committed so a
# fresh checkout still compiles (the server then shows backend/web/placeholder.html).
/backend/web/dist/*
!/backend/web/dist/.gitkeep
# Generated GeoNames places dataset (~5 MB): rebuild with `make places`
/frontend/public/places/places.v1.json
/frontend/.cache/
# Dependencies and test scratch
node_modules/
/e2e/.tmp/
# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/
# Local secrets (API tokens)
.env.local
.env*.local
